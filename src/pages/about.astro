    <section class="max-w-4xl">
      <nav class="flex items-center justify-between">
        <h1 class="text-xl font-bold">Quatton</h1>

        <ul class="flex space-x-4 text-muted-content">
          <li>
            <a href="/" class="link">Blog</a>
          </li>
          <li>
            <a href="/about" class="link">About</a>
          </li>
          <li>
            <a href="/contact" class="link">Projects</a>
          </li>
        </ul>
      </nav>
    </section>
    <section class="prose max-w-4xl">
      <Introduction />
    </section>
  </main>
