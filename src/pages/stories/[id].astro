---
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import Story from "@/components/stories/Story.astro";
import Full from "@/components/stories/Full.astro";
import { Image } from "astro:assets";

export const getStaticPaths = (async () => {
  const entries = await getCollection("stories");

  return entries.map((post) => ({
    params: { id: post.id }
  }));
}) satisfies GetStaticPaths;

const id = Astro.params.id;

if (!id) {
  Astro.redirect("/");
  return;
}

const post = await getEntry("stories", id);

if (!post) {
  Astro.redirect("/");
  return;
}

const { Content, headings } = await render(post);
---

<Layout title={post.data.title}>
  <ul
    class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm"
    popover
    id="tableofcontent"
    style="position-anchor:--hamburger-menu"
  >
    {
      headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="text-sm"
            style={`padding-left: ${heading.depth * 8}px;`}
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
  <main class="h-full w-full flex flex-col" data-story-id={post.id}>
    <header class="text-sm py-2 border-b border-base-300">
      <div
        class="flex items-center gap-4 justify-between mx-auto px-4 w-full max-w-md"
      >
        <a href="/" class="btn btn-ghost btn-square" aria-label="Back to home"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m15 18l-6-6l6-6"></path></svg
          >
        </a>
        <a href="#page1">{post.data.title}</a>
        <button
          class="btn btn-ghost btn-square"
          popovertarget="tableofcontent"
          style="anchor-name:--hamburger-menu"
        >
          <span class="sr-only">Menu</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 5h16M4 12h16M4 19h16"></path></svg
          >
        </button>
      </div>
    </header>
    <div
      class="w-full max-w-md sm:aspect-9/16 flex-1 mx-auto flex flex-col min-h-0"
    >
      <div class="progress w-sm"></div>
      <article class="carousel scroll min-h-0 flex-1">
        <Content components={{ Story, Full, Image }} />
      </article>
    </div>
  </main>
</Layout>

<script>
  import { actions } from "astro:actions";

  const root = document.querySelector("main[data-story-id]");
  const storyId = root?.getAttribute("data-story-id");

  (() => {
    if (import.meta.env.PUBLIC_ANALYTICS_DISABLED === "true") {
      return;
    }

    if (storyId) {
      const utmSource = new URLSearchParams(window.location.search).get(
        "utm_source"
      );

      actions
        .analytics({
          storyId,
          utmSource: utmSource ?? undefined
        })
        .catch(() => {});
    }
  })();
</script>

<style>
  main {
    timeline-scope: --scale-progress;
  }

  .scroll {
    scroll-timeline: --scale-progress inline;
  }

  .progress {
    top: 0;
    left: 0;
    height: 4px;
    width: 100%;
    transform-origin: left;
    transform: scaleX(0);
    animation: scaleProgress auto linear;
    animation-timeline: --scale-progress;
    color: var(--color-primary);
  }

  @keyframes scaleProgress {
    0% {
      transform: scaleX(0);
    }
    100% {
      transform: scaleX(1);
    }
  }
</style>
