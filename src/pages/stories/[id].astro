---
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import Story from "@/components/stories/Story.astro";
import Full from "@/components/stories/Full.astro";
import { Image } from "astro:assets";

export const getStaticPaths = (async () => {
  const entries = await getCollection("stories");

  return entries
    .filter((post) => import.meta.env.DEV || !!post.data.publishedAt)
    .map((post) => ({
      params: { id: post.id }
    }));
}) satisfies GetStaticPaths;

const id = Astro.params.id;

if (!id) {
  Astro.redirect("/");
  return;
}

const post = await getEntry("stories", id);

if (!post) {
  Astro.redirect("/");
  return;
}

const { Content, headings } = await render(post);
---

<Layout title={post.data.title}>
  <ul
    class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm"
    popover
    id="tableofcontent"
    style="position-anchor:--hamburger-menu"
  >
    {
      headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="text-sm"
            style={`padding-left: ${heading.depth * 8}px;`}
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
  <main class="h-full w-full flex flex-col" data-story-id={post.id}>
    <header class="text-sm py-2 border-b border-base-300">
      <div
        class="flex items-center gap-4 justify-between mx-auto px-4 w-full max-w-md"
      >
        <a href="/" class="btn btn-ghost btn-square" aria-label="Back to home"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m15 18l-6-6l6-6"></path></svg
          >
        </a>
        <a href="#page1">{post.data.title}</a>
        <button
          class="btn btn-ghost btn-square"
          popovertarget="tableofcontent"
          style="anchor-name:--hamburger-menu"
        >
          <span class="sr-only">Menu</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 5h16M4 12h16M4 19h16"></path></svg
          >
        </button>
      </div>
    </header>
    <div
      class="w-full max-w-md sm:aspect-9/16 flex-1 mx-auto flex flex-col min-h-0"
    >
      <div class="progress w-sm"></div>
      <article class="story-content carousel scroll min-h-0 flex-1">
        <Content components={{ Story, Full, Image }} />
      </article>
    </div>
  </main>
</Layout>

<script>
  import { actions } from "astro:actions";

  const root = document.querySelector("main[data-story-id]");
  const storyId = root?.getAttribute("data-story-id");

  (() => {
    const isAnalyticsDisabled = import.meta.env.PUBLIC_ANALYTICS_DISABLED;
    if (["true", "1", "yes"].includes(isAnalyticsDisabled)) {
      return;
    }

    if (storyId) {
      const utmSource = new URLSearchParams(window.location.search).get(
        "utm_source"
      );

      actions
        .analytics({
          storyId,
          utmSource: utmSource ?? undefined
        })
        .catch(() => {});
    }
  })();
</script>

<style>
  main {
    timeline-scope: --scale-progress;
  }

  .scroll {
    scroll-timeline: --scale-progress inline;
  }

  .progress {
    top: 0;
    left: 0;
    height: 4px;
    width: 100%;
    transform-origin: left;
    transform: scaleX(0);
    animation: scaleProgress auto linear;
    animation-timeline: --scale-progress;
    color: var(--color-primary);
  }

  @keyframes scaleProgress {
    0% {
      transform: scaleX(0);
    }
    100% {
      transform: scaleX(1);
    }
  }

  .story-content {
    position: relative;
  }

  :global(.story-content .footnotes) {
    position: absolute;
    right: 0;
    bottom: 6rem;
    left: 0;
    font-size: 0.75rem;
    line-height: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 30;
    transform: translateY(0.25rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0s linear 150ms;
    background-color: color-mix(
      in oklab,
      var(--color-base-100) 78%,
      transparent
    );
    border: 1px solid var(--color-base-300);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  :global(.story-content .footnotes-list) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.story-content .footnotes-list > li) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.35rem;
    align-items: start;
    margin: 0.35rem 0 0;
  }

  :global(.story-content iframe) {
    position: relative;
    z-index: 12;
  }

  :global(.story-content .footnote-backdrop) {
    position: absolute;
    inset: 0;
    z-index: 15;
    display: none;
    background: transparent;
    pointer-events: auto;
  }

  :global(.story-content:has(.footnotes li:target) .footnote-backdrop) {
    display: block;
  }

  :global(.story-content .footnote-label) {
    font-weight: 600;
    white-space: nowrap;
  }

  :global(.story-content .footnote-body) {
    min-width: 0;
    position: relative;
    padding-right: 1.25rem;
  }

  :global(.story-content .footnote-dismiss) {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    color: var(--color-base-content);
    text-decoration: none;
    opacity: 0.5;
    line-height: 1;
  }

  :global(.story-content .footnote-dismiss:is(:hover, :focus-visible)) {
    opacity: 1;
    background-color: color-mix(
      in oklab,
      var(--color-base-content) 12%,
      transparent
    );
  }

  :global(.story-content .footnote-body > :first-child) {
    margin-top: 0;
  }

  :global(.story-content .footnote-body > :last-child) {
    margin-bottom: 0;
  }

  :global(
    .story-content:has([data-footnote-ref]:is(:hover, :focus, :focus-visible))
      .footnotes
  ),
  :global(.story-content:has(.footnotes li:target) .footnotes) {
    opacity: 0.9;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }
</style>
