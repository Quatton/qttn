---
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import Story from "@/components/stories/Story.astro";
import Full from "@/components/stories/Full.astro";
import { Image } from "astro:assets";

export const getStaticPaths = (async () => {
  const entries = await getCollection("stories");

  return entries
    .filter((post) => import.meta.env.DEV || !!post.data.publishedAt)
    .map((post) => ({
      params: { id: post.id },
    }));
}) satisfies GetStaticPaths;

const id = Astro.params.id;

if (!id) {
  Astro.redirect("/");
  return;
}

const post = await getEntry("stories", id);

if (!post) {
  Astro.redirect("/");
  return;
}

const { Content, headings } = await render(post);
---

<Layout title={post.data.title} lang={post.data.lang}>
  <ul
    class="menu dropdown w-52 rounded-box bg-base-100 shadow-sm"
    popover
    id="tableofcontent"
    style="position-anchor:--hamburger-menu"
  >
    {headings.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class="text-sm"
          style={`padding-left: ${heading.depth * 8}px;`}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
  <div class="flex h-dvh flex-col items-center [timeline-scope:--story-progress]">
    <header class="w-full max-w-md shrink-0 border-b border-base-300 bg-base-100 py-2 text-sm lg:max-w-2xl">
      <div class="mx-auto flex w-full max-w-md items-center justify-between gap-4 px-4 lg:max-w-2xl">
        <a href="/" class="btn btn-square btn-ghost" aria-label="Back to home">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m15 18l-6-6l6-6"
            ></path>
          </svg>
        </a>
        <a href="#page1">{post.data.title}</a>
        <button
          class="btn btn-square btn-ghost"
          popovertarget="tableofcontent"
          style="anchor-name:--hamburger-menu"
        >
          <span class="sr-only">Menu</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 5h16M4 12h16M4 19h16"
            ></path>
          </svg>
        </button>
      </div>
    </header>
    <div class="story-progress h-1 w-full max-w-md shrink-0 origin-left bg-base-300 lg:max-w-2xl"></div>
    <main
      class:list={[
        "story-content",
        post.data.direction === "vertical" ? "overflow-y-auto" : "",
        "flex min-h-0 w-full flex-1 flex-col",
        post.data.direction === "vertical" ? "[scroll-timeline:--story-progress_block]" : "",
      ]}
      data-story-id={post.id}
      data-direction={post.data.direction}
    >
      <article
        class:list={[
          post.data.direction === "horizontal" &&
            "carousel [scroll-timeline:--story-progress_inline]",
          "relative mx-auto min-h-0 max-w-md flex-1 lg:max-w-2xl",
        ]}
      >
        <Content components={{ Story, Full, Image }} />
      </article>
    </main>
  </div>
</Layout>

<script>
  import { formatBookmarkStorageKey } from "@/lib/utils";
  import { actions } from "astro:actions";

  (() => {
    const article = document.querySelector("main");
    if (!article) return;

    const storyId = article?.dataset.storyId;
    const direction = article?.dataset.direction;

    const isAnalyticsDisabled = import.meta.env.PUBLIC_ANALYTICS_DISABLED;
    if (!["true", "1", "yes"].includes(isAnalyticsDisabled)) {
      if (storyId) {
        const utmSource = new URLSearchParams(window.location.search).get("utm_source");

        actions
          .analytics({
            storyId,
            utmSource: utmSource ?? undefined,
          })
          .catch(() => {});
      }
    }

    // if no hash, get bookmark from localStorage and scroll to it
    if (!location.hash) {
      const pathname = location.pathname;
      const bookmarkKey = formatBookmarkStorageKey(pathname);
      const bookmark = localStorage.getItem(bookmarkKey);
      window.history.replaceState(null, "", bookmark ? `#${bookmark}` : pathname);
      if (bookmark) {
        const el = document.querySelector(`#${bookmark}`);
        if (el) {
          el.scrollIntoView({
            behavior: import.meta.env.DEV ? "instant" : "smooth",
          });
        }
      }
    }

    // auto update hash on scroll

    const as = article.querySelectorAll("a");

    for (const a of as) {
      if (new URL(a.href).origin !== location.origin) a.target = "_blank";
      if (a.dataset.footnoteRef === "true") {
        a.addEventListener("click", (e) => {
          e.preventDefault();
        });
      }
    }

    if (direction === "vertical") {
      const pages = Array.from(article.querySelectorAll<HTMLElement>("[id^='page']"));
      let updateScheduled = false;

      const updatePageHash = () => {
        updateScheduled = false;

        const readingLine = article.getBoundingClientRect().top + article.clientHeight * 0.25;
        const activePage = pages.find((page) => {
          const bounds = page.getBoundingClientRect();
          return bounds.top <= readingLine && bounds.bottom > readingLine;
        });

        if (activePage && location.hash !== `#${activePage.id}`) {
          window.history.replaceState(window.history.state, "", `#${activePage.id}`);
        }
      };

      article.addEventListener(
        "scroll",
        () => {
          if (updateScheduled) return;
          updateScheduled = true;
          requestAnimationFrame(updatePageHash);
        },
        { passive: true },
      );

      if (!location.hash) updatePageHash();
    }
  })();
</script>

<style>
  .story-progress {
    animation: scaleProgress auto linear;
    animation-timeline: --story-progress;
  }

  @keyframes scaleProgress {
    0% {
      transform: scaleX(0);
    }
    100% {
      transform: scaleX(1);
    }
  }

  :global(.story-content .footnotes) {
    position: absolute;
    right: 0;
    bottom: 6rem;
    left: 0;
    font-size: 0.75rem;
    line-height: 1rem;
    opacity: 0;
    visibility: hidden;
    z-index: 30;
    transform: translateY(0.25rem);
    transition:
      opacity 150ms 300ms,
      transform 150ms 300ms,
      visibility 0s linear 450ms;
    background-color: color-mix(in oklab, var(--color-base-100) 78%, transparent);
    border: 1px solid var(--color-base-300);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  :global(.story-content .footnotes-list) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.story-content .footnotes-list > li) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.35rem;
    align-items: start;
    margin: 0.35rem 0 0;
  }

  :global(.story-content iframe) {
    position: relative;
    z-index: 12;
  }

  :global(.story-content .footnote-backdrop) {
    position: absolute;
    inset: 0;
    z-index: 15;
    display: none;
    background: transparent;
    pointer-events: auto;
  }

  :global(.story-content:has(.footnotes li:target) .footnote-backdrop) {
    display: block;
  }

  :global(.story-content .footnote-label) {
    font-weight: 600;
    white-space: nowrap;
  }

  :global(.story-content .footnote-body) {
    min-width: 0;
    position: relative;
    padding-right: 1.25rem;
  }

  :global(.story-content .footnote-dismiss) {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    color: var(--color-base-content);
    text-decoration: none;
    opacity: 0.5;
    line-height: 1;
  }

  :global(.story-content .footnote-dismiss:is(:hover, :focus-visible)) {
    opacity: 1;
    background-color: color-mix(in oklab, var(--color-base-content) 12%, transparent);
  }

  :global(.story-content .footnote-body > :first-child) {
    margin-top: 0;
  }

  :global(.story-content .footnote-body > :last-child) {
    margin-bottom: 0;
  }

  :global(.story-content:has([data-footnote-ref]:is(:hover, :focus, :focus-visible)) .footnotes),
  :global(.story-content .footnotes:is(:hover, :focus-within)),
  :global(.story-content:has(.footnotes li:target) .footnotes) {
    opacity: 0.9;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }
</style>
