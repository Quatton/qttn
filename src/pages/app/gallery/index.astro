---
import Layout from "@/layouts/Layout.astro";
import { getAppHref } from "@/lib/utils";
---

<Layout title="Gallery">
  <main class="container mx-auto h-[100dvh] pt-16">
    <section class="max-w-3xl px-8 py-32">
      <h1 class="text-6xl font-semibold">Gallery</h1>
      <p class="mt-4 text-lg text-pretty">
        A more visual and rich version of my blogs that MDX might not be enough.
      </p>
    </section>
  </main>
</Layout>
