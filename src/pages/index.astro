---
import Header from "@/layouts/Header.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatDate, formatDateShort } from "../lib/utils";

const posts = await getCollection("stories");

const publishedPosts = posts.filter((post) => !!post.data.publishedAt);
---

<Layout title="Home">
  <Header class="max-w-3xl mx-auto" />
  <div class="overflow-x-auto max-w-3xl mx-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th class="sm:w-48 max-sm:w-24">Date</th>
          <th>Title</th>
        </tr>
      </thead>
      <tbody>
        {
          publishedPosts.map((post) => (
            <tr>
              <td>
                <p class="max-sm:hidden">{formatDate(post.data.createdAt)}</p>
                <p class="sm:hidden">{formatDateShort(post.data.createdAt)}</p>
              </td>
              <td>
                <a href={`/stories/${post.id}`} class="link link-hover">
                  {post.data.title}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>
