---
import { getAppHref } from "@/lib/utils";
import Layout from "../layouts/Layout.astro";
import Introduction from "../components/index/Introduction.md";

import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "blog",
  (entry) => import.meta.env.DEV || !!entry.data.publishedAt,
);

allPosts.sort((a, b) => {
  if (a.data.publishedAt && b.data.publishedAt) {
    return a.data.publishedAt > b.data.publishedAt ? -1 : 1;
  }
  if (a.data.publishedAt && !b.data.publishedAt) {
    return 1;
  }
  if (!a.data.publishedAt && b.data.publishedAt) {
    return -1;
  }
  if (!a.data.publishedAt && !b.data.publishedAt) {
    return a.data.createdAt > b.data.createdAt ? -1 : 1;
  }
  return 0;
});
---

<Layout>
  <main class="container mx-auto space-y-8 py-24">
    <section class="prose max-w-4xl">
      <Introduction />
    </section>
    <section class="max-w-4xl">
      <h2 class="text-xl font-semibold">Recent Projects</h2>
      <div class="mt-8 grid grid-cols-1 gap-8">
        <div class="border-box card border">
          <div class="card-body">
            <h3 class="card-title">CONST!</h3>
            <p class="mt-4 text-lg text-secondary-content">
              Const is a collection of fun constrained writing prompts for you
              to play and share with your friends.
            </p>

            <div class="card-actions justify-end">
              <a href={getAppHref("const")} class="btn btn-sm"> Let's Play </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="max-w-4xl">
      <h2 class="text-xl font-semibold">Blog</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Published</th>
          </tr>
        </thead>
        <tbody>
          {
            allPosts.map(({ data, id }) => (
              <tr class="hover">
                <td>
                  <a href={`/app/blog/${id}`} class="link">
                    {data.title}
                  </a>
                </td>
                <td>
                  {data.publishedAt
                    ? Intl.DateTimeFormat("en-US", {
                        dateStyle: "medium",
                      }).format(data.publishedAt)
                    : "(Draft)"}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </main>
</Layout>
