---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { formatDate } from "../lib/utils";

const posts = await getCollection("blog");

const publishedPosts = posts.filter((post) => !!post.data.publishedAt);
---

<Layout>
  <div class="overflow-x-auto max-w-3xl">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th class="w-48">Date</th>
          <th>Title</th>
        </tr>
      </thead>
      <tbody>
        {
          publishedPosts.map((post) => (
            <tr>
              <td>{formatDate(post.data.createdAt)}</td>
              <td>
                <a href={`/blog/${post.id}`} class="link link-hover">
                  {post.data.title}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>
