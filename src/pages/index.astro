---
import NavBar from "@/components/NavBar.astro";
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "blog",
  (entry) => import.meta.env.DEV || !!entry.data.publishedAt,
);

allPosts.sort((a, b) => {
  if (a.data.publishedAt && b.data.publishedAt) {
    return a.data.publishedAt > b.data.publishedAt ? -1 : 1;
  }
  if (a.data.publishedAt && !b.data.publishedAt) {
    return 1;
  }
  if (!a.data.publishedAt && b.data.publishedAt) {
    return -1;
  }
  if (!a.data.publishedAt && !b.data.publishedAt) {
    return a.data.createdAt > b.data.createdAt ? -1 : 1;
  }
  return 0;
});
---

<Layout>
  <main class="container mx-auto space-y-8 px-4 py-24">
    <NavBar />
    <section class="max-w-4xl">
      <table class="table">
        <thead>
          <tr>
            <th>Published</th>
            <th>Title</th>
          </tr>
        </thead>
        <tbody>
          {
            allPosts.map(({ data, id }) => (
              <tr class="hover">
                <td>
                  {data.publishedAt
                    ? new Intl.DateTimeFormat("en-US", {
                        year: "numeric",
                        month: "short",
                      }).format(new Date(data.publishedAt))
                    : "Unpublished"}
                </td>
                <td>
                  <a href={`/blog/${id}`} class="link">
                    {data.title}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </main>
</Layout>
