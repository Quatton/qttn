---
import Layout from "@/layouts/Layout.astro";
import { getAppHref } from "@/lib/utils";
---

<Layout>
  <main class="container mx-auto space-y-8 px-2 py-24">
    <section class="max-w-4xl">
      <nav class="flex items-center justify-between">
        <h1 class="text-xl font-bold">Quatton</h1>

        <ul class="flex space-x-4 text-muted-content">
          <li>
            <a href="/" class="link">Blog</a>
          </li>
          <li>
            <a href="/about" class="link">About</a>
          </li>
          <li>
            <a href="/contact" class="link">Projects</a>
          </li>
        </ul>
      </nav>
    </section>
    <section class="max-w-4xl">
      <h2 class="text-xl font-semibold">Recent Projects</h2>
      <div class="mt-8 grid grid-cols-1 gap-8">
        <div class="border-box card border">
          <div class="card-body">
            <h3 class="card-title">CONST!</h3>
            <p class="mt-4 text-lg text-secondary-content">
              Const is a collection of fun constrained writing prompts for you
              to play and share with your friends.
            </p>

            <div class="card-actions justify-end">
              <a href={getAppHref("const")} class="btn btn-sm"> Let's Play </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
