---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export const prerender = true;

export const getStaticPaths = (async () => {
  const galleryEntries = await getCollection("gallery");
  return galleryEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const id = Astro.params.id;
const gallery = await getEntry("gallery", id);
if (!gallery) {
  return Astro.rewrite(`/blog/not-found/${id}`);
}

const { Content } = await render(gallery);
---

<Layout>
  <main class="mx-auto grid min-h-0 w-full flex-1 lg:grid-cols-2">
    <section class="relative h-96 w-full lg:h-full">
      <canvas
        id="canvas"
        class="bg-base-200 absolute top-0 left-0 h-full w-full"></canvas>
    </section>
    <section class="prose overflow-y-auto px-8 py-16">
      <Content />
    </section>
  </main>
</Layout>
