---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export const prerender = true;

export const getStaticPaths = (async () => {
  const galleryEntries = await getCollection("gallery");
  return galleryEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const id = Astro.params.id;
const gallery = await getEntry("gallery", id);
if (!gallery) {
  return Astro.rewrite(`/blog/not-found/${id}`);
}

const { Content } = await render(gallery);
---

<Layout>
  <main class="mx-auto grid min-h-0 w-full flex-1 lg:grid-cols-2">
    <Content />
  </main>
</Layout>
