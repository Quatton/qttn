---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { site } from "../consts/config";
import "../styles/global.css";
interface Props {
  title?: string;
  lang?: "en" | "th" | "ja";
}

const { lang = "en" } = Astro.props;
const title = Astro.props.title ? `${Astro.props.title} | ${site.title}` : site.title;
---

<html lang={lang} data-theme="silk">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" rel="stylesheet" />
    </noscript>
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-merriweather" />
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-plex-sans-thai" />
    <Font cssVariable="--font-noto-sans-jp" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="relative min-h-dvh">
    <slot />
  </body>
</html>
