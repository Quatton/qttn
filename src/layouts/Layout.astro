---
import "@fontsource/merriweather";
import "@fontsource/ibm-plex-mono";
import "@fontsource-variable/inter-tight";

import "@/styles/globals.css";
import { site } from "@/config/site";
import { getAppHref } from "@/lib/utils";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const app = Astro.url.pathname.split("/app");
const baseRoute = app[1]?.split("/")[1];
const { title = baseRoute } = Astro.props;
---

<!doctype html>
<html lang="en" class="w-screen overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="I make web better." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{site.title}{title && ` | ${title}`}</title>
  </head>
  <body class="bg-base-100 flex h-dvh flex-col overflow-x-hidden scroll-smooth">
    <header
      class="border-b-base-300 sticky top-0 z-50 flex h-16 items-center gap-4 px-6 py-4 shadow-md backdrop-blur-md"
    >
      <a
        href={`${site.url.full}`}
        class="font-serif text-2xl font-semibold transition-all hover:-translate-y-1"
      >
        <span>{site.title}</span>
      </a>
      {
        baseRoute && (
          <>
            <div class="border-content h-6 border-l-2" />
            <a
              href={getAppHref(baseRoute)}
              class="text-xl font-semibold transition-all hover:-translate-y-1"
            >
              <span>{title}</span>
            </a>
          </>
        )
      }
    </header>
    <slot />
  </body>
</html>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const scrollpos = sessionStorage.getItem("scrollpos");
    if (scrollpos) {
      const scrollposNum = parseInt(scrollpos, 10);
      setTimeout(function () {
        document.body.scrollTo(0, scrollposNum);
        // sessionStorage.removeItem("scrollpos");
      }, 10);
    }
  });

  window.addEventListener("beforeunload", function () {
    sessionStorage.setItem("scrollpos", document.body.scrollTop);
  });
</script>
