---
import { site } from "@/consts/config";
import { cn } from "@/lib/utils";
import { type ClassValue } from "clsx";

interface Props {
  class?: ClassValue;
}

const className = Astro.props.class || "";
---

<header class={cn("p-4", className)}>
  <a href="/" class="font-serif text-2xl font-bold">
    {site.title}
  </a>
</header>
