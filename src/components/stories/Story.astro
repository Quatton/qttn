---
interface Props {
  page: number | string;
  isLast?: boolean;
}

const page = Number(Astro.props.page);
const isLast = Astro.props.isLast || false;
---

<div class="carousel-item w-full h-full shrink-0" id={`page${page}`}>
  <div
    class="w-full flex flex-col justify-center items-center relative text-center prose prose-lg prose-silk prose-h1:font-serif prose-h2:font-serif prose-h3:font-serif prose-h4:font-serif prose-h5:font-serif prose-h6:font-serif py-16 max-sm:px-2 prose-blockquote:[&_p:first-child]:mt-0 prose-blockquote:[&_p:first-child]:mb-0 text-pretty prose-blockquote:text-left prose-a:z-20 prose-a:relative"
  >
    <div class="absolute flex inset-0">
      <a href={`#page${page - 1}`} class="h-full flex-1 z-10 not-prose">
        <span class="sr-only">Previous</span>
      </a>
      {
        !isLast && (
          <a href={`#page${page + 1}`} class="h-full flex-1 z-10 not-prose">
            <span class="sr-only">Next</span>
          </a>
        )
      }
    </div>
    <slot />
  </div>
</div>

<script>
  // auto scroll to #page{n} on mount

  if (location.hash) {
    const el = document.querySelector(location.hash);
    if (el) {
      el.scrollIntoView({ behavior: "smooth" });
    }
  }
</script>
