---
interface Props {
  page: number | string;
  isLast?: boolean;
}

const page = Number(Astro.props.page);
const isLast = Astro.props.isLast || false;
---

<div
  class="flex flex-col h-full carousel-item w-full relative"
  id={`page${page}`}
>
  <div class="absolute flex inset-0 z-10">
    <a href={`#page${page - 1}`} class="h-full flex-1">
      <span class="sr-only">Previous</span>
    </a>
    {
      !isLast && (
        <a href={`#page${page + 1}`} class="h-full flex-1">
          <span class="sr-only">Next</span>
        </a>
      )
    }
  </div>
  <slot />
</div>
