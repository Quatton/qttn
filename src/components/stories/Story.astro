---
interface Props {
  page: number | string;
  isLast?: boolean;
  total?: number | string;
}

const page = Number(Astro.props.page);
const total = Number(Astro.props.total) || page;
const isLast = Astro.props.isLast || false;
---

<div class="carousel-item w-full h-full shrink-0" id={`page${page}`}>
  <div
    class="w-full flex flex-col justify-center items-center relative text-center prose prose-lg prose-silk prose-h1:font-serif prose-h2:font-serif prose-h3:font-serif prose-h4:font-serif prose-h5:font-serif prose-h6:font-serif py-16 max-sm:px-2 prose-blockquote:[&_p:first-child]:mt-0 prose-blockquote:[&_p:first-child]:mb-0 text-pretty prose-blockquote:text-left prose-a:z-20 prose-a:relative"
  >
    <div class="absolute flex inset-0">
      <a href={`#page${page - 1}`} class="h-full flex-1 z-10 not-prose">
        <span class="sr-only">Previous</span>
      </a>
      {
        !isLast && (
          <a href={`#page${page + 1}`} class="h-full flex-1 z-10 not-prose">
            <span class="sr-only">Next</span>
          </a>
        )
      }
      <!-- Page number / total (top right) -->
      <div class="absolute top-4 right-4 badge badge-sm z-20 not-prose">
        {page} / {total}
      </div>

      <!-- bookmark copy the current page URL to clipboard (top left) -->
      <button
        class="absolute top-4 left-4 btn btn-square z-20 not-prose"
        title="Copy page URL"
        id={`copy-page-url-${page}`}
      >
        <span class="sr-only">Copy page URL</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          class="size-6"
          ><path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z"
          ></path></svg
        >
      </button>
    </div>
    <slot />
  </div>
</div>

<script>
  // auto scroll to #page{n} on mount

  if (location.hash) {
    const el = document.querySelector(location.hash);
    if (el) {
      el.scrollIntoView({ behavior: "smooth" });
    }
  }

  function copyPageURL() {
    const url = `${location.origin}${location.pathname}#page${Astro.props.page}`;
    navigator.clipboard.writeText(url).then(() => {
      alert("Page URL copied to clipboard!");
    });
  }

  document
    .getElementById(`copy-page-url-${Astro.props.page}`)
    ?.addEventListener("click", copyPageURL);
</script>
