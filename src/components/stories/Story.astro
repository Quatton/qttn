---
import { cn } from "@/lib/utils";
import { BookmarkButton } from "./BookmarkButton";
import { Share } from "./Share";

interface Props {
  page: number | string;
  isLast?: boolean;
  total?: number | string;
  direction: "horizontal" | "vertical";
}

const page = Number(Astro.props.page);
const total = Number(Astro.props.total) || page;
const isLast = Astro.props.isLast || false;
const direction = Astro.props.direction;
---

<div class="carousel-item w-full h-full shrink-0" id={`page${page}`}>
  <div
    class={cn(
      direction === "vertical" ? "justify-center" : "justify-center",
      "w-full flex flex-col items-center relative text-center prose prose-lg prose-silk prose-h1:font-serif prose-h1:leading-tight prose-h2:font-serif prose-h3:font-serif prose-h4:font-serif prose-h5:font-serif prose-h6:font-serif py-16 px-4 prose-blockquote:[&_p:first-child]:mt-0 prose-blockquote:[&_p:first-child]:mb-0 [&_li.task-list-item]:list-none [&_.contains-task-list]:w-full [&_.contains-task-list]:text-left text-pretty prose-blockquote:text-left prose-a:z-20 prose-a:relative prose-li:text-left prose-p:my-2 prose-headings:my-2 prose-blockquote:my-2 prose-ul:my-2 prose-ol:my-2 prose-hr:my-2 prose-table:my-2 prose-pre:my-2 prose-figure:my-2"
    )}
  >
    <a
      href={`#page${page}`}
      class="footnote-backdrop not-prose"
      aria-hidden="true"
      tabindex="-1"></a>
    <div class="absolute flex top-0 left-0 w-full h-16">
      {
        direction == "horizontal" && (
          <div class="flex w-full h-full">
            <a href={`#page${page - 1}`} class="h-full flex-1 z-10 not-prose">
              <span class="sr-only">Previous</span>
            </a>
            <a
              href={`#page${isLast ? page : page + 1}`}
              class="h-full flex-1 z-10 not-prose"
            >
              <span class="sr-only">Next</span>
            </a>
          </div>
        )
      }

      <div class="absolute top-4 right-4 badge badge-sm z-20 not-prose">
        {page} / {total}
      </div>
      <BookmarkButton page={page} client:only="react" />
      <Share documentId={`page${page}`} client:only="react" />
    </div>
    <slot />
  </div>
</div>

<script>
  // auto scroll to #page{n} on mount

  if (location.hash) {
    const el = document.querySelector(location.hash);
    if (el) {
      el.scrollIntoView({
        behavior: import.meta.env.DEV ? "instant" : "smooth"
      });
    }
  }
</script>
