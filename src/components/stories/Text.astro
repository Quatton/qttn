---
import { cn } from "@/lib/utils";

interface Props {
  size: "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "3xl";
  class?: string;
}

const size = Astro.props.size || "lg";
const extraClass = Astro.props.class || "";
---

<div
  class={cn(
    "relative prose px-8 text-center prose-h1:font-serif",
    size === "xs"
      ? "prose-xs"
      : size === "sm"
        ? "prose-sm"
        : size === "md"
          ? "prose-md"
          : size === "lg"
            ? "prose-lg"
            : size === "xl"
              ? "prose-xl"
              : size === "2xl"
                ? "prose-2xl"
                : size === "3xl"
                  ? "prose-3xl"
                  : "prose-lg",
    extraClass
  )}
>
  <slot />
</div>
