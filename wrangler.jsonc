{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qttn",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "qttn.dev",
      "custom_domain": true,
    },
    {
      "pattern": "const.qttn.dev",
      "custom_domain": true,
    },
  ],
}