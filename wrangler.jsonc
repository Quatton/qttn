{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qttn",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "fetch_iterable_type_support",
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "qttn.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.qttn.dev",
      "custom_domain": true,
    },
  ],
}
