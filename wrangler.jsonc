{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qttn",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-02-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "qttn.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.qttn.dev",
      "custom_domain": true
    }
  ]
}
